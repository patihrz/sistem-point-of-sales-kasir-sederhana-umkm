generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  KARYAWAN
}

enum PaymentMethod {
  TUNAI
  QRIS
  DEBIT
  TRANSFER
}

enum TransactionStatus {
  COMPLETED
  PENDING
  CANCELLED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  role         Role          @default(KARYAWAN)
  isActive     Boolean       @default(true)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id               String            @id @default(cuid())
  name             String
  sku              String            @unique
  barcode          String?           @unique
  price            Decimal           @db.Decimal(12, 2) // Harga Jual
  costPrice        Decimal           @default(0.00) @db.Decimal(12, 2) // Harga Modal
  stock            Int               @default(0)
  unit             String            @default("pcs")
  imageUrl         String?           @db.Text
  isActive         Boolean           @default(true)
  categoryId       String?
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactionItems TransactionItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([categoryId])
  @@map("products")
}

model Transaction {
  id            String            @id @default(cuid())
  invoiceNumber String            @unique
  totalAmount   Decimal           @db.Decimal(12, 2)
  discount      Decimal           @default(0.00) @db.Decimal(12, 2)
  tax           Decimal           @default(0.00) @db.Decimal(12, 2)
  finalAmount   Decimal           @db.Decimal(12, 2)
  paidAmount    Decimal           @db.Decimal(12, 2)
  changeAmount  Decimal           @db.Decimal(12, 2)
  paymentMethod PaymentMethod     @default(TUNAI)
  status        TransactionStatus @default(COMPLETED)
  notes         String?           @db.Text
  userId        String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         TransactionItem[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId])
  @@map("transactions")
}

model TransactionItem {
  id              String      @id @default(cuid())
  transactionId   String
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName     String
  priceAtPurchase Decimal     @db.Decimal(12, 2)
  quantity        Int
  subtotal        Decimal     @db.Decimal(12, 2)
  createdAt       DateTime    @default(now())

  @@index([transactionId])
  @@index([productId])
  @@map("transaction_items")
}

model StoreSetting {
  id            String   @id @default("default")
  storeName     String   @default("Toko Saya")
  address       String?  @db.Text
  phoneNumber   String?
  logoUrl       String?  @db.Text // path logo toko yang di-upload owner
  receiptFooter String?  @default("Terima kasih atas kunjungan Anda!")
  updatedAt     DateTime @updatedAt

  @@map("store_settings")
}

